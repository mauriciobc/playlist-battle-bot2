# Mastodon instance the bot account lives on (same-instance-only games)
MASTODON_URL=https://mastodon.example

# Access token scopes: read:notifications read:statuses write:statuses write:conversations
MASTODON_TOKEN=

# Bot account handle without domain, e.g. playlistbattle
BOT_ACCT=

# Game timing (seconds) — Mastodon allows 300 (5 min) – 604800 (7 days) per poll
POLL_DURATION_SEC=900
ACCEPTANCE_WINDOW_SEC=86400
SUBMISSION_WINDOW_SEC=172800

# Early poll close: resolve a poll before expiry once votes stop changing.
# Requires visible tallies (do not enable hide_totals on polls).
EARLY_CLOSE_ENABLED=1
EARLY_CLOSE_MIN_AGE_SEC=300
EARLY_CLOSE_STAGNATION_SEC=300

# Rate limits
CREATION_COOLDOWN_SEC=600
MAX_GAMES_PER_PLAYER=3

# v1.1 replacement window for unavailable round tunes (minutes)
REPLACEMENT_GRACE_MIN=15

# Account auto-delete window (hours) — warn if games may outlive posts
AUTO_DELETE_WINDOW_HOURS=0

# SQLite database path (mount as volume in Docker)
DB_PATH=./data/bot.db

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Bot reply language: en | pt-BR
LOCALE=en

# Optional: bot-account YouTube Music cookie. Copy the full `Cookie` request
# header of a logged-in music.youtube.com session (it must contain
# __Secure-3PAPISID). When set, each finale also publishes a saved playlist to
# that account; when unset, finales fall back to an anonymous YouTube queue
# link, which needs no account at all.
YT_COOKIE=

# X-Goog-AuthUser index — set only for brand accounts
YT_AUTH_USER=0

# Visibility of the published playlist: PUBLIC | PRIVATE | UNLISTED
YT_PLAYLIST_PRIVACY=PUBLIC
