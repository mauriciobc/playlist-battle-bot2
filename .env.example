# Mastodon instance the bot account lives on (same-instance or federated games)
MASTODON_URL=https://mastodon.example

# Access token scopes: read:notifications read:statuses write:statuses write:conversations
MASTODON_TOKEN=

# Bot account handle without domain, e.g. playlistbattle
BOT_ACCT=

# Game timing (seconds) — Mastodon allows 300 (5 min) – 604800 (7 days) per poll.
# POLL_DURATION_SEC is the hard cap on a round; early close (below) ends most
# rounds well before it. Invitees who have not answered when ACCEPTANCE_WINDOW_SEC
# ends are auto-declined and the duel starts without them. Submission runs from
# the first accept, in parallel with the rest of the acceptance window.
POLL_DURATION_SEC=14400
ACCEPTANCE_WINDOW_SEC=1800
SUBMISSION_WINDOW_SEC=86400

# Early poll close: resolve a poll before expiry once votes stop changing.
# Requires visible tallies (do not enable hide_totals on polls).
#
# A poll with at least 3 votes (the quorum) closes once it is MIN_AGE old and its
# votes have been still for STAGNATION. A poll below quorum could only score a
# tie, so it waits UNDER_QUORUM_MIN_AGE first (an unvoted poll stays open that
# long for voters to arrive).
#
# These values are only honoured outside RUN_MODE=test. Under test mode they
# collapse to 0 so the bot's own suite can finish a game in seconds.
EARLY_CLOSE_ENABLED=1
EARLY_CLOSE_MIN_AGE_SEC=900
EARLY_CLOSE_STAGNATION_SEC=900
EARLY_CLOSE_UNDER_QUORUM_MIN_AGE_SEC=3600

# Operating mode. Overrides TEST_MODE.
#   production - full cadence; polls close on their own terms.
#   e2e        - fast loops, but a poll stays open long enough for an outside
#                client to read it and cast a vote. Use this to drive the real
#                Mastodon API from a test harness.
#   test       - thresholds collapse to zero; a game finishes in seconds.
# The 300s poll floor is unchanged in every mode; Mastodon rejects less.
RUN_MODE=production

# Legacy spelling kept for existing deployments: TEST_MODE=1 with no RUN_MODE
# means RUN_MODE=test (zeroed early-close thresholds).
# TEST_MODE=1

# Loop cadence overrides (seconds). Defaults come from RUN_MODE:
# production 15/60/300, e2e 5/10/30, test 5/10/60.
# NOTIFICATION_INTERVAL_SEC=15
# SCHEDULER_INTERVAL_SEC=60
# RECOVERY_INTERVAL_SEC=300

# Rate limits
CREATION_COOLDOWN_SEC=600
MAX_GAMES_PER_PLAYER=3
# Attempts (backoff doubling from 1 min) to deliver a badge announcement
MERIT_ANNOUNCE_MAX_ATTEMPTS=8

# v1.1 replacement window for unavailable round tunes (minutes)
REPLACEMENT_GRACE_MIN=15

# Account auto-delete window (hours) — warn if games may outlive posts
AUTO_DELETE_WINDOW_HOURS=0

# SQLite database path (mount as volume in Docker)
DB_PATH=./data/bot.db

# Log level: fatal|error|warn|info|debug|trace
# Use debug in live/staging to trace notifications, Mastodon HTTP, and sweeps.
LOG_LEVEL=info

# Human-readable colorized logs for local runs (needs devDependency pino-pretty;
# production images fall back to JSON). 1 = on, 0 = off.
LOG_PRETTY=0

# Bot reply language: en | pt-BR
LOCALE=en

# Build identity logged at startup as "playlist-battle bot 0.1.0 (<sha>) starting".
# Set to the git short SHA when building/deploying so logs show which commit is
# running; leave unset for local runs (logged as "dev").
GIT_SHA=

# Optional: bot-account YouTube Music cookie. Copy the full `Cookie` request
# header of a logged-in music.youtube.com session (it must contain
# __Secure-3PAPISID). When set, each finale also publishes a saved playlist to
# that account; when unset, finales fall back to an anonymous YouTube queue
# link, which needs no account at all.
YT_COOKIE=

# X-Goog-AuthUser index — set only for brand accounts
YT_AUTH_USER=0

# Visibility of the published playlist: PUBLIC | PRIVATE | UNLISTED
YT_PLAYLIST_PRIVACY=PUBLIC
