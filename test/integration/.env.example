# Playlist Battle Bot — Integration Driver Configuration
#
# Read by driver.ts from ./.env in its working directory:
#   cp .env.example .env && npx tsx driver.ts    # from test/integration/
# All tokens need scopes: read write follow

# Bot under test (handle WITHOUT @)
BOT_ACCT=playlistbattle
BOT_INSTANCE=mastodon.social

# Host account (posts the newgame, submits tunes, votes)
HOST_INSTANCE=mastodon.social
HOST_TOKEN=
HOST_ACCT=

# Player 1 (the challenger: accepts the invite, submits tunes, votes)
PLAYER1_INSTANCE=ursal.zone
PLAYER1_TOKEN=
PLAYER1_ACCT=

# Third voter. ROUND_QUORUM is 3 and the bot owns the poll, so without a
# spectator every round ties. Leave commented out to vote as player 1.
# VOTER1_TOKEN=
# VOTER1_API_URL=

# Explicit API origins (optional; default https://<instance>)
# HOST_API_URL=
# PLAYER1_API_URL=

# Game settings. A unique run suffix is appended to the theme.
GAME_THEME=E2E
PLAYLIST_LENGTH=8
# Mastodon rejects polls under 5 minutes (300s). Do not lower this.
POLL_DURATION_SEC=300

# Custom tune URLs (optional — defaults to a pool dealt alternately; a few
# ids may have gone private upstream, which the submit step reports as rejected).
# Comma-separated YouTube URLs; the two lists must not share a video.
# TUNE_URLS_HOST=https://youtube.com/watch?v=...,https://...
# TUNE_URLS_PLAYER1=https://youtube.com/watch?v=...,https://...

# Backstops in seconds: deadlines against a hang, not waits
# BACKSTOP_CREATE_SEC=120
# BACKSTOP_ACCEPT_SEC=180
# BACKSTOP_SUBMIT_SEC=300
# BACKSTOP_POLL_SEC=900
# BACKSTOP_FINALE_SEC=2400
# POLL_INTERVAL_MS=4000

# Debug output
DEBUG=1
# ── Test mode ────────────────────────────────────────────────────────────
# Set TEST_MODE=1 on the BOT container to compress a full game into minutes.
#
#   Loop cadence:  notifications 15s→5s, scheduler 60s→10s, recovery 300s→60s
#   Early close:   stale polls resolve as soon as votes stop moving (0s/0s)
#   Windows:       set ACCEPTANCE_WINDOW_SEC / SUBMISSION_WINDOW_SEC yourself
#
# It does NOT shorten POLL_DURATION_SEC — Mastodon rejects polls under 300s
# ("Deadline is too soon"). Rounds are sped up by closing polls early, not by
# asking the instance for an impossible poll.
