# Playlist Battle Bot — Integration Test Configuration
#
# Copy this to .env and fill in your values.
# All tokens need scopes: read write follow

# Mastodon instance (where the bot lives)
MASTODON_URL=https://mastodon.social

# Bot account handle (WITHOUT @)
BOT_ACCT=playlistbattle

# Host account (creates the game)
HOST_TOKEN=
HOST_ACCT=

# Player 1 (accepts invite, submits tunes, votes)
PLAYER1_TOKEN=
PLAYER1_ACCT=

# Player 2 (optional — for 2-player game)
PLAYER2_TOKEN=
PLAYER2_ACCT=

# Game settings (defaults are fine for most tests)
GAME_THEME=integration test
PLAYLIST_LENGTH=8
# Mastodon rejects polls under 5 minutes (300s). Do not lower this.
POLL_DURATION_SEC=300

# Custom tune URLs (optional — uses test stubs if not set)
# Comma-separated YouTube URLs, must match PLAYLIST_LENGTH
# TUNE_URLS_PLAYER1=https://youtube.com/watch?v=...,https://...
# TUNE_URLS_PLAYER2=https://youtube.com/watch?v=...,https://...

# Timeouts
WAIT_TIMEOUT_SEC=420
POLL_WAIT_SEC=65
POLL_CHECK_INTERVAL_SEC=5
FINALE_TIMEOUT_SEC=1800

# Debug output
DEBUG=1
